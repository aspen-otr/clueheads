[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/popups/popup_npc_setup.gd" id="1_script"]
[ext_resource type="Theme" path="res://ui/main_menu/themes/menu_theme.tres" id="2_theme"]

[node name="PopupNPCSetup" type="Window"]
title = "Configure NPC Players"
initial_position = 1
size = Vector2i(520, 525)
visible = false
transient = true
exclusive = true
unresizable = true
popup_wm_hint = true
minimize_disabled = true
maximize_disabled = true
script = ExtResource("1_script")

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="Contents" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Panel/Margin/Contents"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Choose Your NPCs"
horizontal_alignment = 1

[node name="Description" type="Label" parent="Panel/Margin/Contents"]
layout_mode = 2
text = "Choose 1-5 NPCs. Set each to Random or Strategic."
horizontal_alignment = 1
autowrap_mode = 2

[node name="CountRow" type="HBoxContainer" parent="Panel/Margin/Contents"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="CountLabel" type="Label" parent="Panel/Margin/Contents/CountRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Number of NPCs"

[node name="NpcCount" type="SpinBox" parent="Panel/Margin/Contents/CountRow"]
custom_minimum_size = Vector2(110, 34)
layout_mode = 2
min_value = 1.0
max_value = 5.0
value = 1.0
step = 1.0
rounded = true

[node name="PlayerCount" type="Label" parent="Panel/Margin/Contents"]
layout_mode = 2
text = "Players: 1 human + 1 NPC = 2 / 6 total"
horizontal_alignment = 1

[node name="Separator" type="HSeparator" parent="Panel/Margin/Contents"]
layout_mode = 2

[node name="BehaviorsLabel" type="Label" parent="Panel/Margin/Contents"]
layout_mode = 2
text = "Choose each NPC's behavior:"

[node name="NpcRows" type="VBoxContainer" parent="Panel/Margin/Contents"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Spacer" type="Control" parent="Panel/Margin/Contents"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="Buttons" type="HBoxContainer" parent="Panel/Margin/Contents"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="CancelButton" type="Button" parent="Panel/Margin/Contents/Buttons"]
custom_minimum_size = Vector2(150, 46)
layout_mode = 2
theme_type_variation = &"RedButton"
text = "Cancel"

[node name="ConfirmButton" type="Button" parent="Panel/Margin/Contents/Buttons"]
custom_minimum_size = Vector2(150, 46)
layout_mode = 2
theme_type_variation = &"GreenButton"
text = "Confirm"
